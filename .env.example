NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only enable for local previews. Production requires Supabase and provider keys.
DEMO_MODE=true
# Future verified billing and rewarded-ad providers; never put secrets in NEXT_PUBLIC_ variables.
BILLING_PROVIDER=
AD_PROVIDER=
# Android bundle: only public configuration is included. Leave API_URL empty for an offline demo.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
NEXT_PUBLIC_ADMOB_REWARDED_ID=
# Server only. Configure matching Google Play product identifiers in RevenueCat.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT=premium
REVENUECAT_WEEKLY_PRODUCT=roast_premium_weekly
REVENUECAT_MONTHLY_PRODUCT=roast_premium_monthly
ALLOW_SANDBOX_PURCHASES=false
# Set AdMob SSV reward to 5 credits, and its callback to /api/webhooks/admob.
ADMOB_REWARDED_AD_UNIT=
NATIVE_APP_ORIGINS=https://localhost

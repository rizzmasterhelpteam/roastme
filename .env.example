NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
GOOGLE_API_KEY=
# Preferred name; GOOGLE_API_KEY remains supported for existing deployments.
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only enable for local previews. Production requires Supabase and provider keys.
DEMO_MODE=true
# Future verified billing and rewarded-ad providers; never put secrets in NEXT_PUBLIC_ variables.
BILLING_PROVIDER=
AD_PROVIDER=
# Android bundle: only public configuration is included. Leave API_URL empty for an offline demo.
NEXT_PUBLIC_API_URL=
# Development-only Google rewarded test unit: ca-app-pub-3940256099942544/5224354917
NEXT_PUBLIC_ADMOB_REWARDED_ID=
# Server only: entire Google Play service-account JSON. Required before paid checkout.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Optional override of the bundled public RSA licensing key.
GOOGLE_PLAY_LICENSE_KEY=
GOOGLE_PLAY_MONTHLY_PRODUCT=monthly
GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_WEEKLY_PRODUCT=weekly
GOOGLE_PLAY_WEEKLY_BASE_PLAN_ID=goweekly
ALLOW_SANDBOX_PURCHASES=false
# Android SDK completion grants a one-time +5 reward; no SSV is required.
ADMOB_REWARDED_AD_UNIT=
NATIVE_APP_ORIGINS=https://localhost

# Web-only Dodo subscriptions. All values below are SERVER-ONLY.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEEKLY_PRODUCT_ID=
DODO_PAYMENTS_MONTHLY_PRODUCT_ID=
